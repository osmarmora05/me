---
import { getEntry, render } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import WraperMarkdown from "../../layouts/WraperMarkdown.astro";

export { localizedPaths as getStaticPaths } from "../../lib/utils";

const lang = getLangFromUrl(Astro.url);

const about = await getEntry("about", lang);

if (!about) {
    throw new Error("Not found about content");
}

const { Content } = await render(about);
---

<Layout title={`osmarmora05 - ${about.data.title}`}>
    <WraperMarkdown>
        <Content />
    </WraperMarkdown>
</Layout>
