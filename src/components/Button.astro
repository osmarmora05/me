---
import { cn } from "cnfast";

interface Props {
    class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<button
    type="button"
    class={cn(
        "inline-flex items-center justify-center border border-transparent hover:border-border hover:bg-split bg-transparent rounded-md w-fit cursor-pointer px-2.5 py-1",
        className,
    )}
    {...rest}
>
    <slot />
</button>
