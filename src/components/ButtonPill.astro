---
import { cn } from "cnfast";

interface Props {
    class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<button
    type="button"
    class={cn(
        "bg-split shadow-xs font-medium  rounded-full px-4 py-1 text-xs border border-border",
        className,
    )}
    {...rest}
>
    <slot />
</button>
